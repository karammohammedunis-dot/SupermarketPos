<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SupermarketPos.Wpf</RootNamespace>
    <AssemblyName>SupermarketPos</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Supermarket POS</Product>
    <Company>Sm3th</Company>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupermarketPos.Application\SupermarketPos.Application.csproj" />
    <ProjectReference Include="..\SupermarketPos.Domain\SupermarketPos.Domain.csproj" />
    <ProjectReference Include="..\SupermarketPos.Infrastructure\SupermarketPos.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
  </ItemGroup>

</Project>
