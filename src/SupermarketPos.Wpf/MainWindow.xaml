<Window x:Class="SupermarketPos.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        Title="{loc:T App_Title}" Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Shell: sidebar + content (visible once logged in) -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,22">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="🛒 POS" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="6,0,0,24" />

                        <Button Content="{loc:T Nav_Pos}" Command="{Binding ShowPosCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="pos">
                                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:T Nav_Products}" Command="{Binding ShowProductsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="products">
                                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:T Nav_Reports}" Command="{Binding ShowReportsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="reports">
                                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{loc:T Nav_Settings}" Command="{Binding ShowSettingsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="settings">
                                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding UserDisplay}" Style="{StaticResource Muted}" Margin="6,0,0,10" TextWrapping="Wrap" />
                        <Button Content="{loc:T Nav_Logout}" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" />
                    </StackPanel>

                    <Grid />
                </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- Login (full screen, while signed out) -->
        <ContentControl Content="{Binding Login}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}" />
    </Grid>
</Window>
