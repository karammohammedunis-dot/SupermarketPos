<Window x:Class="SupermarketPos.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        Title="{loc:T App_Title}" Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/app.ico"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Sidebar nav item: white text on the brand gradient, white pill when active -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11" Padding="16,12">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon + localized label, both following the button's foreground -->
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Shell: sidebar + content (visible once logged in) -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrandGradient}">
                <DockPanel Margin="16,24">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="🛒 Market POS" FontSize="22" FontWeight="Bold" Foreground="White" Margin="6,0,0,28" />

                        <Button Command="{Binding ShowDashboardCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" Margin="0,0,12,0" Style="{StaticResource NavText}" />
                                <TextBlock Text="{loc:T Nav_Dashboard}" Style="{StaticResource NavText}" />
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="dashboard">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ShowPosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="16" Margin="0,0,12,0" Style="{StaticResource NavText}" />
                                <TextBlock Text="{loc:T Nav_Pos}" Style="{StaticResource NavText}" />
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="pos">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ShowProductsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0" Style="{StaticResource NavText}" />
                                <TextBlock Text="{loc:T Nav_Products}" Style="{StaticResource NavText}" />
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="products">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ShowReportsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0" Style="{StaticResource NavText}" />
                                <TextBlock Text="{loc:T Nav_Reports}" Style="{StaticResource NavText}" />
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="reports">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ShowSettingsCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="16" Margin="0,0,12,0" Style="{StaticResource NavText}" />
                                <TextBlock Text="{loc:T Nav_Settings}" Style="{StaticResource NavText}" />
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveScreen}" Value="settings">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Border Background="#26FFFFFF" CornerRadius="11" Padding="12,10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding UserDisplay}" Foreground="White" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <Button Content="{loc:T Nav_Logout}" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" />
                        <TextBlock Text="Developed by Sm3th" Foreground="#99FFFFFF" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>

                    <Grid />
                </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- Login (full screen, while signed out) -->
        <ContentControl Content="{Binding Login}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}" />
    </Grid>
</Window>
