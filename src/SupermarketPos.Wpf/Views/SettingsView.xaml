<UserControl x:Class="SupermarketPos.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <DockPanel>
            <TextBlock Text="{loc:T Settings_Title}" Style="{StaticResource H1}" DockPanel.Dock="Top" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Width="520" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_StoreName}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Text="{loc:T Settings_StoreAddress}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{loc:T Settings_Language}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{loc:T Settings_LowStockThreshold}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:T Settings_VatRates}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding VatRatesCsv, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />

                    <Button Content="{loc:T Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
