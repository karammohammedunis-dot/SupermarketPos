<UserControl x:Class="SupermarketPos.Wpf.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Background="{StaticResource BgBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding OpenCashCommand}" />
        <KeyBinding Key="F3" Command="{Binding OpenCardCommand}" />
        <KeyBinding Key="F4" Command="{Binding ClearCartDiscountCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: search + cart -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="18" Padding="14,12">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{loc:T Pos_ScanPrompt}" Foreground="{StaticResource MutedBrush}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- search results -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12"
                    Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding SearchResults}" MaxHeight="180">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddFromResultsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Style="{StaticResource GhostButton}"
                                    HorizontalContentAlignment="Stretch" Margin="0,2">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} ₺}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- cart -->
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Lines}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Pos_Product}" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Pos_UnitPrice}" Binding="{Binding UnitPriceText}" Width="120" IsReadOnly="True"
                                            ElementStyle="{StaticResource Money}" />
                        <DataGridTextColumn Header="{loc:T Pos_Qty}" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" Width="90" />
                        <DataGridTextColumn Header="{loc:T Pos_LineTotal}" Binding="{Binding LineTotalText}" Width="120" IsReadOnly="True"
                                            ElementStyle="{StaticResource Money}" />
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}" Padding="6,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- RIGHT: totals + payment -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{loc:T Pos_Total}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding GrossTotalText}" Style="{StaticResource BigMoney}" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text="{loc:T Pos_ItemCount}" /><Run Text=": " /><Run Text="{Binding ItemCountText}" />
                        </TextBlock>
                    </Grid>

                    <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />

                    <TextBlock Text="{loc:T Pos_VatBreakdown}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding VatBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Text="{Binding RateText}" HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding NetText}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding VatText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />

                    <!-- cart discount -->
                    <TextBlock Text="{loc:T Pos_CartDiscount}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CartDiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="%" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding CartDiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="₺" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="{loc:T Pos_Apply}" Command="{Binding ApplyCartDiscountCommand}"
                                Style="{StaticResource GhostButton}" Padding="12,8" />
                    </Grid>
                    <TextBlock Text="{Binding CartDiscountText}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                               Visibility="{Binding CartDiscountText, Converter={StaticResource StrToVis}}" />
                </StackPanel>

                <!-- payment buttons at bottom -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,10" Visibility="{Binding Status, Converter={StaticResource StrToVis}}" />
                    <Button Content="{loc:T Pos_Cash}" Command="{Binding OpenCashCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{loc:T Pos_Card}" Command="{Binding OpenCardCommand}" Style="{StaticResource GhostButton}" Margin="0,4,3,4" />
                        <Button Grid.Column="1" Content="{loc:T Pos_Clear}" Command="{Binding ClearCartDiscountCommand}" Style="{StaticResource GhostButton}" Margin="3,4,0,4" />
                    </Grid>
                </StackPanel>

                <Grid />
            </DockPanel>
        </Border>

        <!-- PAYMENT OVERLAY -->
        <Grid Grid.ColumnSpan="2" Background="#CC000000"
              Visibility="{Binding IsPaymentOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="420" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:T Pos_Pay}" Style="{StaticResource H1}" Margin="0,0,0,16" />

                    <TextBlock Text="{loc:T Pos_Total}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding GrossTotalText}" Style="{StaticResource BigMoney}" Margin="0,0,0,16" />

                    <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Pos_Tendered}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Tendered, UpdateSourceTrigger=PropertyChanged}" FontSize="20" />
                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{loc:T Pos_Change}" Style="{StaticResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChangeText}" Style="{StaticResource Money}" FontSize="22" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{loc:T Common_Cancel}" Command="{Binding CancelPaymentCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="{loc:T Pos_Pay}" Command="{Binding CompletePaymentCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
