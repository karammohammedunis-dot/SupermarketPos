<UserControl x:Class="SupermarketPos.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: X/Z report -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="{loc:T Reports_Title}" Style="{StaticResource H1}" DockPanel.Dock="Top" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T Reports_Day}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <DatePicker SelectedDate="{Binding SelectedDay}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{loc:T Reports_XReport}" Command="{Binding GenerateXCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="{loc:T Reports_ZReport}" Command="{Binding GenerateZCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource H1}" FontSize="20" Margin="0,0,0,12" />

                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_SaleCount}" Style="{StaticResource Muted}" HorizontalAlignment="Left" /><TextBlock Text="{Binding SaleCountText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_Gross}" HorizontalAlignment="Left" /><TextBlock Text="{Binding GrossText}" HorizontalAlignment="Right" Style="{StaticResource Money}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_Net}" Style="{StaticResource Muted}" HorizontalAlignment="Left" /><TextBlock Text="{Binding NetText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_Vat}" Style="{StaticResource Muted}" HorizontalAlignment="Left" /><TextBlock Text="{Binding VatText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" /></Grid>

                    <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{loc:T Pos_VatBreakdown}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding VatBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Text="{Binding RateText}" HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding NetText}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding VatText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{loc:T Reports_PaymentSplit}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_CashTotal}" HorizontalAlignment="Left" /><TextBlock Text="{Binding CashText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_CardTotal}" HorizontalAlignment="Left" /><TextBlock Text="{Binding CardText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>

                    <Button Content="{loc:T Reports_ExportPdf}" Command="{Binding ExportReportCommand}" Style="{StaticResource GhostButton}" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- RIGHT: history -->
        <DockPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T Reports_History}" Style="{StaticResource H1}" FontSize="18" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding HistoryFrom}" Width="130" Margin="0,0,8,0" />
                    <DatePicker Grid.Column="2" SelectedDate="{Binding HistoryTo}" Width="130" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Content="{loc:T Reports_Generate}" Command="{Binding LoadHistoryCommand}" Style="{StaticResource GhostButton}" />
                    <Button Grid.Column="5" Content="{loc:T Reports_OpenReceipt}" Command="{Binding OpenReceiptCommand}" Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedSale}" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Reports_ReceiptNo}" Binding="{Binding ReceiptNo}" Width="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Reports_Date}" Binding="{Binding DateText}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Reports_Cashier}" Binding="{Binding Cashier}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Reports_Payment}" Binding="{Binding PaymentText}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Pos_Total}" Binding="{Binding TotalText}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource Money}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
