<UserControl x:Class="SupermarketPos.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22,20" />
            <Setter Property="Height" Value="128" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{loc:T Nav_Pos}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Command="{Binding DataContext.ShowPosCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="{loc:T Nav_Products}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Command="{Binding DataContext.ShowProductsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="{loc:T Nav_Reports}" Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.ShowReportsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>

            <!-- section: today -->
            <TextBlock Grid.Row="1" Text="Bugün" FontSize="18" FontWeight="Bold" Margin="2,0,0,12" />
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,26">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3B82F6" Offset="0" /><GradientStop Color="#FF2563EB" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="💰  Bugünkü Ciro" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding RevenueText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF10B981" Offset="0" /><GradientStop Color="#FF059669" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="🧾  Bugünkü Satış" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding SaleCountText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF59E0B" Offset="0" /><GradientStop Color="#FFD97706" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="🏛  Toplanan KDV" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding VatText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- section: catalog -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="Katalog" FontSize="18" FontWeight="Bold" Margin="2,0,0,12" />
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,16,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF8B5CF6" Offset="0" /><GradientStop Color="#FF7C3AED" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="📦  Toplam Ürün" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ProductsText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,16,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFEC4899" Offset="0" /><GradientStop Color="#FFDB2777" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="🗂  Kategoriler" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding CategoriesText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFEF4444" Offset="0" /><GradientStop Color="#FFDC2626" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="⚠  Düşük Stok" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding LowStockText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
