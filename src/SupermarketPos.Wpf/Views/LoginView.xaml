<UserControl x:Class="SupermarketPos.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Border Style="{StaticResource Card}" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
            <StackPanel>
                <TextBlock Text="🛒 Supermarket POS" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="{loc:T Login_Title}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                <TextBlock Text="{loc:T Login_Username}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="{loc:T Login_Password}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,4,0,8" Visibility="{Binding Error, Converter={StaticResource StrToVis}}" />

                <Button Content="{loc:T Login_Button}" Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" />

                <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,18,0,0"
                           Text="admin / admin  •  kasa / 1234" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
