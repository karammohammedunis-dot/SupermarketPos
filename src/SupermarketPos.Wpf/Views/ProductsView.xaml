<UserControl x:Class="SupermarketPos.Wpf.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                <TextBlock Text="{loc:T Products_Title}" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Content="{loc:T Products_LowStockOnly}" IsChecked="{Binding LowStockOnly}"
                              VerticalAlignment="Center" Margin="0,0,18,0" />
                    <Button Content="{loc:T Products_ShelfLabels}" Command="{Binding PrintLabelsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0" />
                    <Button Content="{loc:T Products_New}" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid ItemsSource="{Binding Products}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                    <Setter Property="Background" Value="#22EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="40" Height="40">
                                        <Border CornerRadius="8" Background="{Binding Product.CategoryId, Converter={StaticResource CatColor}}">
                                            <TextBlock Text="{Binding Product.Name, Converter={StaticResource Initials}}" Foreground="White"
                                                       FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Rectangle RadiusX="8" RadiusY="8" Visibility="{Binding Product.ImagePath, Converter={StaticResource HasImageToVis}}">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding Product.ImagePath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:T Products_Barcode}" Binding="{Binding Barcode}" Width="150" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Products_Name}" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Products_Category}" Binding="{Binding CategoryName}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Products_Price}" Binding="{Binding PriceText}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource Money}" />
                        <DataGridTextColumn Header="{loc:T Products_Vat}" Binding="{Binding VatText}" Width="70" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Products_Unit}" Binding="{Binding UnitText}" Width="60" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Products_Stock}" Binding="{Binding StockText}" Width="80" IsReadOnly="True" ElementStyle="{StaticResource Money}" />
                        <DataGridTemplateColumn Header="{loc:T Products_Status}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="999" Padding="11,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2216A34A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="#22EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{loc:T Common_Edit}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,4,0" />
                                        <Button Content="✕"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,4" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- EDITOR OVERLAY -->
        <Grid Background="#660F172A" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="460" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:T Products_New}" Style="{StaticResource H1}" FontSize="20" Margin="0,0,0,16" />

                    <TextBlock Text="{loc:T Products_Barcode}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Editor.Barcode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <TextBlock Text="{loc:T Products_Name}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{loc:T Products_Price}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Editor.Price, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{loc:T Products_Vat}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Editor.VatRates}" SelectedItem="{Binding Editor.VatRate}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}%{0:P0}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{loc:T Products_Stock}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Editor.Stock, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{loc:T Products_Category}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Editor.Categories}" SelectedValue="{Binding Editor.CategoryId}"
                                      SelectedValuePath="Id" DisplayMemberPath="Name" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="{loc:T Products_Kilogram}" IsChecked="{Binding Editor.IsKilogram}" Margin="0,0,0,12" />

                    <!-- product image -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="58" Height="58" Margin="0,0,12,0">
                            <Border CornerRadius="10" Background="{Binding Editor.CategoryId, Converter={StaticResource CatColor}}">
                                <TextBlock Text="{Binding Editor.Name, Converter={StaticResource Initials}}" Foreground="White"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Rectangle RadiusX="10" RadiusY="10" Visibility="{Binding Editor.ImagePath, Converter={StaticResource HasImageToVis}}">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Editor.ImagePath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{loc:T Products_ChooseImage}" Command="{Binding Editor.BrowseImageCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                            <Button Content="✕" Command="{Binding Editor.ClearImageCommand}" Style="{StaticResource DangerButton}" Padding="11,6" />
                        </StackPanel>
                    </Grid>

                    <!-- restock (existing only) -->
                    <Grid Margin="0,4,0,16" Visibility="{Binding Editor.IsNew, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding RestockAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{loc:T Products_Restock}" Command="{Binding RestockCommand}" Style="{StaticResource GhostButton}" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{loc:T Common_Cancel}" Command="{Binding CancelEditCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="{loc:T Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
